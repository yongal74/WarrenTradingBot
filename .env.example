# WarrenTradingActivebot 환경 변수 설정
# 이 파일을 .env 로 복사 후 값을 입력하세요

# 실행 모드 (PAPER / LIVE)
TRADING_MODE=PAPER

# 초기 가상 자금 (Paper Trading)
PAPER_CAPITAL=10000000

# ── 빗썸 API (코인 자동매매) ─────────────────────────────────
# 빗썸 → 마이페이지 → API 관리 → API 생성
# 권한: 조회 + 거래 (출금은 비활성)
BITHUMB_API_KEY=your_bithumb_connect_key
BITHUMB_SECRET_KEY=your_bithumb_secret_key

# ── 한국투자증권 KIS API (한국주식 자동매매) ─────────────────
# KIS Developers → 앱키 발급
# https://apiportal.koreainvestment.com
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=your_account_number
KIS_ACCOUNT_PROD=01
KIS_MODE=paper   # paper / live

# ── Alpaca API (미국주식 - 추후) ─────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── 텔레그램 알림 ────────────────────────────────────────────
# 1) @BotFather → /newbot → TOKEN 발급
# 2) @userinfobot 으로 CHAT_ID 확인
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── 기타 ─────────────────────────────────────────────────────
WEBHOOK_SECRET=warren2024
WEBHOOK_PORT=8080
